# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by all agents (override per-agent in src/core/config.py if desired)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Where learner session state is persisted (JSON file store)
DATA_DIR=./data
